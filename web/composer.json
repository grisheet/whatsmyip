{
    "name": "grisheet/whatsmyip-web",
    "description": "The What's My IP public lookup website.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "stevebauman/location": "dev-local"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": true,
                "versions": {"stevebauman/location": "dev-local"},
                "reference": "config"
            }
        }
    ],
    "autoload": {
        "psr-4": {"App\\": "app/"}
    },
    "autoload-dev": {
        "psr-4": {"Tests\\": "tests/"}
    },
    "scripts": {
        "post-autoload-dump": ["@php artisan package:discover --ansi"],
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
